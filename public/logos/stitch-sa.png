    <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6823036cd77b3093eaf9154d" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script src="https://cdn.prod.website-files.com/6823036cd77b3093eaf9154d/js/webflow.b6ea2e8c.fc7044298deeb372.js" type="text/javascript" integrity="sha384-NN1JF+tPfOTVXySnEqqQIddC9ChKljVNkeHp+iBeiQgPs8vG3O7D9hJXIz325pGT" crossorigin="anonymous"></script><!-- Stitch Docs -->
    <script>
      const clientId = '320855721983986218';
      const redirectUri = 'https://stitch.sa/callback';
      const issuer = 'https://dev.stitch.fi';

      function base64UrlEncode(str) {
        return btoa(String.fromCharCode(...new Uint8Array(str)))
          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      }

      async function generateCodeChallenge(verifier) {
        const encoder = new TextEncoder();
        const data = encoder.encode(verifier);
        const digest = await crypto.subtle.digest('SHA-256', data);
        return base64UrlEncode(digest);
      }

      document.getElementById('login-button').addEventListener('click', async () => {
        const codeVerifier = [...crypto.getRandomValues(new Uint8Array(64))]
          .map(x => ('0' + x.toString(16)).slice(-2)).join('');

        sessionStorage.setItem('pkce_verifier', codeVerifier);

        const codeChallenge = await generateCodeChallenge(codeVerifier);
        const state = crypto.randomUUID();

        const authUrl = `${issuer}/oauth/v2/authorize?` +
          `client_id=${clientId}` +
          `&response_type=code` +
          `&scope=openid profile email` +
          `&redirect_uri=${encodeURIComponent(redirectUri)}` +
          `&code_challenge=${codeChallenge}` +
          `&code_challenge_method=S256` +
          `&state=${state}`;

        window.location.href = authUrl;
      });
    </script>


    <!-- Footer message -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const HEIGHT = 25; // px per message (matches your wrapper height)
        const DURATION = 600; // ms for the slide animation
        const HOLD = 2400; // ms to sit on each message (3s total per item)
        const STEP = DURATION + HOLD;

        const wrapper = document.querySelector(".footer-message-changing-wrapper");
        if (!wrapper) return;

        // Collect current messages
        const originalMsgs = Array.from(wrapper.querySelectorAll(".footer-message-changing-text"));
        if (originalMsgs.length === 0) return;

        // Build a track and move messages into it
        const track = document.createElement("div");
        track.className = "footer-message-track";
        wrapper.appendChild(track);

        originalMsgs.forEach(el => track.appendChild(el));

        // Clone the first one for the seamless scroll
        const firstClone = originalMsgs[0].cloneNode(true);
        track.appendChild(firstClone);

        const total = originalMsgs.length; // number of REAL messages
        let index = 0;
        let timerId;

        // Ensure each message is exactly the right height (safety)
        const normalizeHeights = () => {
          Array.from(track.children).forEach(el => {
            el.style.height = HEIGHT + "px";
            el.style.lineHeight = HEIGHT + "px";
          });
        };
        normalizeHeights();

        const slide = () => {
          index += 1;

          // Animate to next position
          track.style.transition = `transform ${DURATION}ms ease-in-out`;
          track.style.transform = `translateY(${-index * HEIGHT}px)`;

          // When we reach the clone (index === total), after the transition ends,
          // jump back to the real first item without the user seeing it.
          if (index === total) {
            track.addEventListener("transitionend", handleLoopReset, {
              once: true
            });
          }

          // Schedule next tick
          timerId = setTimeout(slide, STEP);
        };

        const handleLoopReset = () => {
          // Remove transition to snap instantly
          track.style.transition = "none";
          track.style.transform = "translateY(0)";
          index = 0;

          // Force reflow so the browser acknowledges the style change,
          // ensuring the next animated step works
          void track.offsetHeight;
        };

        // Start after a short initial hold so the first message sits for HOLD ms
        timerId = setTimeout(slide, HOLD);

        // Optional: clean up on page hide (SPA/nav)
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            clearTimeout(timerId);
          } else {
            // restart
            clearTimeout(timerId);
            track.style.transition = "none";
            track.style.transform = "translateY(0)";
            index = 0;
            void track.offsetHeight;
            timerId = setTimeout(slide, HOLD);
          }
        });
      });
    </script>


    <!-- FAQs -->
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        const faqAccordions = document.querySelectorAll(".faq1_accordion");

        function closeAllFaqs() {
          faqAccordions.forEach(faq => {
            faq.classList.remove("active");

            const answer = faq.querySelector(".faq1_answer");
            const icon = faq.querySelector(".faq-icon-minus.plus");

            if (answer) {
              answer.style.height = answer.scrollHeight + "px"; // set current height
              requestAnimationFrame(() => {
                answer.style.height = "0px";
              });
            }

            if (icon) icon.style.transform = "rotate(90deg)";
          });
        }

        faqAccordions.forEach(faq => {
          faq.addEventListener("click", function() {
            const isActive = faq.classList.contains("active");

            // Close all first
            closeAllFaqs();

            // If clicked wasn't active, open it
            if (!isActive) {
              faq.classList.add("active");

              const answer = faq.querySelector(".faq1_answer");
              const icon = faq.querySelector(".faq-icon-minus.plus");

              if (answer) {
                answer.style.height = "0px"; // reset first
                const fullHeight = answer.scrollHeight + "px";
                requestAnimationFrame(() => {
                  answer.style.height = fullHeight;
                });
              }

              if (icon) icon.style.transform = "rotate(0deg)";
            }
          });

          // Set height if initially open
          if (faq.classList.contains("active")) {
            const answer = faq.querySelector(".faq1_answer");
            const icon = faq.querySelector(".faq-icon-minus.plus");

            if (answer) answer.style.height = answer.scrollHeight + "px";
            if (icon) icon.style.transform = "rotate(0deg)";
          }
        });
      });
    </script>

    <!-- Load OIDC Client Library -->
    <script src="https://cdn.jsdelivr.net/npm/oidc-client-ts@latest/dist/browser/oidc-client-ts.min.js"></script>

    <!-- Auth Logic for all Docs buttons -->
    <script>
      const config = {
        authority: "https://docs-auth.stitch.fi",
        client_id: "322051602074634641",
        response_type: "code",
        redirect_uri: "https://stitch.sa/callback",
        scope: "openid email urn:zitadel:iam:org:id:322051324680079761",
        post_logout_redirect_uri: "https://stitch.sa",
        response_mode: "query",
        code_challenge_method: "S256",
      };

      window.userManager = new oidc.UserManager(config);

      document.addEventListener("DOMContentLoaded", function() {
        function signin() {
          window.userManager
            .signinRedirect({
              state: "a2123a67ff11413fa19217a9ea0fbad5",
              prompt: "login",
            })
            .catch(function(err) {
              console.log(err);
            });
        }

        const signinButtons = document.querySelectorAll(".docs-signin-link");
        signinButtons.forEach(btn => {
          btn.addEventListener("click", function(e) {
            e.preventDefault(); // prevent normal link behavior
            signin();
          });
        });
      });
    </script>


    <script>
      // Scrolled down → colored border
      document.addEventListener("DOMContentLoaded", function() {
        const navbar = document.querySelector(".navbar");

        function updateNavbarBorder() {
          if (window.scrollY === 0) {
            // At top → transparent border
            navbar.style.borderBottomColor = "transparent";
          } else {
            // Scrolled down → colored border
            navbar.style.borderBottomColor = "#e7e7e7";
          }
        }

        // Run on load in case user refreshes part-way down
        updateNavbarBorder();

        // Update on scroll
        window.addEventListener("scroll", updateNavbarBorder);
      });
    </script>


